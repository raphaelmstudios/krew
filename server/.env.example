# Copy this file to .env for local settings. .env itself is never committed (see .gitignore).
PORT=4000

# Set to production on the live server (render.yaml already does this). Turns on secure
# cookies, the HTTPS redirect, HSTS and trusting the host's proxy.
NODE_ENV=development

# Extra sites allowed to send changes to the API, comma separated. Leave empty: KREW's own
# pages are always allowed. Only needed if the frontend is ever hosted on a different domain.
ALLOWED_ORIGINS=

# Where data is stored. Leave empty to use server/krew.db and server/uploads. On a host with
# a persistent disk, point both at the disk, for example:
#   DATABASE_PATH=/var/data/krew.db
#   UPLOADS_DIR=/var/data/uploads
DATABASE_PATH=
UPLOADS_DIR=

# Start up jobs (server/src/bootstrap.js).
# Create this admin account when the server starts, if it doesn't exist yet:
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=
# Load the demo accounts and jobs when the database is empty. On the live site, DEMO_PASSWORD
# must be set (8 or more characters) and becomes every demo account's password.
SEED_DEMO_DATA=false
DEMO_PASSWORD=
